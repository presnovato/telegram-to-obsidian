{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": false,
		"inlineSources": false,
		"sourceMap": false,
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node", "obsidian"]
	},
	"include": ["*.ts"]
}
