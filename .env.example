# Скопируй этот файл в .env и заполни. Сам .env в git не коммитится.
#
# --- Обязательные (без них бот не стартует) ---

# Токен бота от @BotFather (команда /newbot).
TELEGRAM_TOKEN=1234567890:ABCdefGHI...

# Твой Telegram user ID от @userinfobot. Только он сможет пользоваться ботом.
ALLOWED_USER_ID=0

# Полный путь к корню хранилища Obsidian. Дефолта нет — задай обязательно.
VAULT_ROOT=C:\path\to\vault

# --- Сеть и прокси ---

# Прокси к api.telegram.org (необязательно). Пусто = прямое соединение.
# Примеры: socks5://127.0.0.1:1080  или  http://user:pass@host:8080
TELEGRAM_PROXY=

# Прокси для зеркал X, CDN и картинок TikTok. Только http/https — urllib не умеет SOCKS.
# Для yt-dlp SOCKS тоже можно, но лучше держать http-прокси.
MEDIA_PROXY=

# Устаревшее имя; читается как запасной вариант, если MEDIA_PROXY пуст. Используй MEDIA_PROXY.
# HTTP_PROXY=

# --- Поведение бота ---

# Куда уходит пост по умолчанию: vault | chat | both. После /mode выбор живёт в state.json.
CAPTURE_MODE=both

# --- Доставка в чат ---

# Что отправлять ссылкой (Telegram качает сам): фото ≈5 МБ, прочее 20 МБ.
# URL_SEND_LIMIT_MB=20

# Максимальный размер файла для заливки ботом. Лимит Bot API — 50 МБ.
# UPLOAD_LIMIT_MB=50

# Таймаут одной заливки, секунды (на медленном канале 60 с не хватает).
# UPLOAD_TIMEOUT_S=300

# Таймаут скачивания форвардов через Bot API, секунды.
# TG_DOWNLOAD_TIMEOUT_S=180

# --- Пересланные сообщения Telegram ---

# Сколько секунд ждать остаток альбома после первого файла.
# TG_ALBUM_WAIT_S=1.5

# Сколько секунд ждать комментарий владельца к форварду.
# TG_COMMENT_WAIT_S=3

# Максимум TikTok/X-ссылок из одного форварда (хвост уходит в предупреждение).
# TG_MAX_LINKED_POSTS=5

# --- OCR фото-каруселей (Tesseract) ---

# Включить распознавание текста на слайдах карусели.
OCR_ENABLED=true

# Полный путь к tesseract.exe, если его нет в PATH. Пусто = искать в PATH.
TESSERACT_CMD=

# Языки распознавания, через +.
OCR_LANGS=rus+eng

# --- Раскладка в vault (переопределяемо) ---

# Папка вложений внутри vault.
# MEDIA_SUBDIR=Meta\Медиафайлы

# Папка заметок TikTok внутри vault.
# NOTES_SUBDIR=1. Входящие\TikTok

# Папка заметок X (Twitter) внутри vault.
# NOTES_SUBDIR_TWITTER=1. Входящие\Twitter

# Папка заметок пересланных сообщений Telegram внутри vault.
# NOTES_SUBDIR_TELEGRAM=1. Входящие\Telegram

# --- Служебные файлы (переопределяемо) ---

# Папка логов. По умолчанию — logs/ рядом с репозиторием.
# LOG_DIR=logs

# Файл выбранного режима (/mode). По умолчанию — state.json рядом с репозиторием.
# STATE_FILE=state.json

# Файл single-instance-лока. По умолчанию — bot.lock рядом с репозиторием.
# LOCK_FILE=bot.lock
